@model List<string>
@{
    ViewData["Title"] = "Log History";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --blue:        #185FA5;
        --blue-dk:     #0C447C;
        --blue-lt:     #EFF6FF;
        --blue-bd:     #BFDBFE;
        --ink:         #111827;
        --ink-2:       #374151;
        --ink-3:       #6B7280;
        --ink-4:       #9CA3AF;
        --bg:          #F4F6F9;
        --surface:     #FAFAFA;
        --white:       #ffffff;
        --border:      #E5E7EB;
        --border-lt:   #F3F4F6;
        --green-lt:    #EAF3DE;
        --green-bd:    #C0DD97;
        --green-tx:    #3B6D11;
        --green-dot:   #639922;
        --radius-sm:   6px;
        --radius-md:   8px;
        --radius-lg:   12px;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
    }

    /* ── Topbar ── */
    .pk-topbar {
        background: var(--white);
        border-bottom: 0.5px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        height: 54px;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .pk-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
    }

    .pk-logo {
        width: 30px;
        height: 30px;
        background: var(--blue);
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pk-logo svg {
        width: 15px;
        height: 15px;
        stroke: #fff;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pk-nav-tag {
        font-size: 11px;
        color: var(--ink-3);
        background: var(--border-lt);
        border: 0.5px solid var(--border);
        border-radius: 4px;
        padding: 2px 9px;
    }

    .pk-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--blue-lt);
        border: 0.5px solid var(--blue-bd);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        color: var(--blue);
    }

    /* ── Hero ── */
    .pk-hero {
        background: var(--white);
        border-bottom: 0.5px solid var(--border);
        padding: 28px 32px;
    }

    .pk-hero-inner {
        max-width: 1080px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .pk-crumb {
        font-size: 11px;
        color: var(--ink-4);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 6px;
    }

    .pk-crumb svg {
        width: 10px;
        height: 10px;
        stroke: var(--ink-4);
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pk-crumb a {
        color: var(--ink-4);
        text-decoration: none;
    }

    .pk-crumb a:hover { color: var(--ink-3); }

    .pk-hero-title {
        font-size: 22px;
        font-weight: 600;
        color: var(--ink);
    }

    .pk-hero-sub {
        font-size: 13px;
        color: var(--ink-3);
        margin-top: 3px;
    }

    .pk-status-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--green-lt);
        border: 0.5px solid var(--green-bd);
        border-radius: 20px;
        padding: 7px 16px;
        font-size: 12px;
        color: var(--green-tx);
        font-weight: 500;
        white-space: nowrap;
    }

    .pk-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green-dot);
        flex-shrink: 0;
    }

    /* ── Content ── */
    .pk-content {
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 32px 56px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ── Card ── */
    .pk-card {
        background: var(--white);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .pk-card-head {
        padding: 14px 22px;
        border-bottom: 0.5px solid var(--border-lt);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--surface);
    }

    .pk-card-head-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pk-card-num {
        width: 22px;
        height: 22px;
        background: var(--border-lt);
        border: 0.5px solid var(--border);
        border-radius: 5px;
        font-size: 10px;
        font-weight: 500;
        color: var(--ink-3);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pk-card-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    .pk-card-meta {
        font-size: 11px;
        color: var(--ink-4);
    }

    /* ── Search bar ── */
    .pk-search-bar {
        padding: 12px 22px;
        border-bottom: 0.5px solid var(--border-lt);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pk-search-wrap {
        position: relative;
        flex: 1;
        max-width: 300px;
    }

    .pk-search-wrap svg {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 13px;
        height: 13px;
        stroke: var(--ink-4);
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
    }

    .pk-search-input {
        width: 100%;
        padding: 8px 10px 8px 30px;
        font-size: 12px;
        border: 0.5px solid var(--border);
        border-radius: var(--radius-sm);
        background: #F9FAFB;
        font-family: inherit;
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s, background 0.15s;
    }

    .pk-search-input:focus {
        border-color: var(--blue-bd);
        background: var(--white);
    }

    .pk-result-count {
        font-size: 11px;
        color: var(--ink-4);
        margin-left: auto;
        white-space: nowrap;
    }

    /* ── Log rows ── */
    .pk-log-item {
        display: grid;
        grid-template-columns: 42px 1fr auto auto;
        align-items: center;
        gap: 16px;
        padding: 14px 22px;
        border-bottom: 0.5px solid var(--border-lt);
        transition: background 0.12s;
    }

    .pk-log-item:last-child { border-bottom: none; }
    .pk-log-item:hover { background: var(--surface); }

    .pk-log-icon {
        width: 38px;
        height: 38px;
        background: var(--blue-lt);
        border: 0.5px solid var(--blue-bd);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pk-log-icon svg {
        width: 16px;
        height: 16px;
        stroke: var(--blue);
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pk-log-date {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    .pk-log-sub {
        font-size: 11px;
        color: var(--ink-4);
        margin-top: 2px;
    }

    .pk-log-badge {
        font-size: 10px;
        font-weight: 500;
        color: var(--ink-3);
        background: var(--border-lt);
        border: 0.5px solid var(--border);
        border-radius: 4px;
        padding: 3px 8px;
        white-space: nowrap;
    }

    /* ── Buttons ── */
    .btn-pk-view {
        font-size: 11px;
        font-weight: 500;
        color: var(--blue);
        background: var(--blue-lt);
        border: 0.5px solid var(--blue-bd);
        border-radius: var(--radius-sm);
        padding: 7px 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.12s;
        white-space: nowrap;
    }

    .btn-pk-view:hover { background: #DBEAFE; }

    .btn-pk-view svg {
        width: 12px;
        height: 12px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ── Empty state ── */
    .pk-empty {
        padding: 48px 22px;
        text-align: center;
        color: var(--ink-4);
        font-size: 13px;
    }

    .pk-empty svg {
        width: 32px;
        height: 32px;
        stroke: var(--border);
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        margin: 0 auto 12px;
        display: block;
    }

    /* ── Footer bar ── */
    .pk-footer-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .pk-footer-meta {
        font-size: 11px;
        color: var(--ink-4);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pk-footer-meta svg {
        width: 12px;
        height: 12px;
        stroke: var(--ink-4);
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .btn-pk-back {
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-2);
        background: var(--white);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 10px 18px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s;
    }

    .btn-pk-back:hover { background: var(--border-lt); }

    .btn-pk-back svg {
        width: 13px;
        height: 13px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .pk-hero, .pk-content { padding-left: 16px; padding-right: 16px; }
        .pk-topbar { padding: 0 16px; }
        .pk-log-item { grid-template-columns: 38px 1fr; }
        .pk-log-badge { display: none; }
        .btn-pk-view { grid-column: 1 / -1; justify-self: start; }
    }
</style>

<!-- Topbar -->
<div class="pk-topbar">
    <a class="pk-brand" href="#">
        <div class="pk-logo">
            <svg viewBox="0 0 24 24">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
            </svg>
        </div>
        Parking Management System
    </a>
    <div style="display:flex;align-items:center;gap:10px;">
        <span class="pk-nav-tag">Admin Panel</span>
        <div class="pk-avatar">AD</div>
    </div>
</div>

<!-- Hero -->
<div class="pk-hero">
    <div class="pk-hero-inner">
        <div>
            <div class="pk-crumb">
                <a href="#">Dashboard</a>
                <svg viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3"/></svg>
                <a asp-action="Index">Control Panel</a>
                <svg viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3"/></svg>
                Log History
            </div>
            <div class="pk-hero-title">Log History</div>
            <div class="pk-hero-sub">ประวัติการจอดรถย้อนหลัง 90 วัน — เลือกวันที่เพื่อดูรายงาน CSV</div>
        </div>
        <div class="pk-status-pill">
            <div class="pk-dot"></div>
            @Model.Count รายการพบ
        </div>
    </div>
</div>

<!-- Content -->
<div class="pk-content">

    <!-- Card 03 — Log List -->
    <div class="pk-card">
        <div class="pk-card-head">
            <div class="pk-card-head-left">
                <div class="pk-card-num">03</div>
                <span class="pk-card-title">รายงานประจำวัน</span>
            </div>
            <span class="pk-card-meta">90 วันย้อนหลัง &middot; CSV format</span>
        </div>

        <!-- Search bar -->
        <div class="pk-search-bar">
            <div class="pk-search-wrap">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="M21 21l-4.35-4.35"/>
                </svg>
                <input class="pk-search-input" type="text" id="logSearch"
                       placeholder="ค้นหาวันที่… เช่น 03-04" />
            </div>
            <span class="pk-result-count" id="resultCount">
                แสดง @Model.Count จาก @Model.Count รายการ
            </span>
        </div>

        <!-- Log rows -->
        <div id="logList">
            @if (Model.Count == 0)
            {
                <div class="pk-empty">
                    <svg viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                    ยังไม่มีข้อมูล Log ในขณะนี้
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    // ✅ 1. แยกก้อนข้อมูล
                    var itemParts = item.Split('|');
                    var fileName = itemParts[0]; 
                    var fileSize = itemParts.Length > 1 ? (long.Parse(itemParts[1]) / 1024).ToString() : "0";

                    <div class="pk-log-item" data-name="@fileName">
                        <div class="pk-log-icon">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>

                        <div>
                            @{
                                var dateParts = fileName.Replace(".csv", "").Split('-');
                                var thaiDate = $"{dateParts[2]}-{dateParts[1]}-{dateParts[0]}";
                            }
                            <div class="pk-log-date">รายงานประจำวันที่ @thaiDate</div>
                            <div class="pk-log-sub">ไฟล์รายวัน &middot; CSV &middot; @fileSize KB</div>
                        </div>

                        <span class="pk-log-badge">CSV</span>
                        
                        <a class="btn-pk-view" 
                        asp-action="LogDetails" 
                        asp-route-fileName="@fileName">
                            <svg viewBox="0 0 24 24">
                                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                                <polyline points="15 3 21 3 21 9"/>
                                <line x1="10" y1="14" x2="21" y2="3"/>
                            </svg>
                            เปิดดูไฟล์
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Footer -->
    <div class="pk-footer-bar">
        <div class="pk-footer-meta">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            Last synced &middot; @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
        </div>
        <a asp-action="Index" class="btn-pk-back">
            <svg viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            กลับสู่ Control Panel
        </a>
    </div>

</div>

<script>
    const rows = Array.from(document.querySelectorAll('.pk-log-item'));
    const total = rows.length;
    const searchInput = document.getElementById('logSearch');
    const resultCount = document.getElementById('resultCount');

    searchInput?.addEventListener('input', function () {
        const q = this.value.trim().toLowerCase(); // สิ่งที่ Toey พิมพ์ เช่น "03-04"
        let visible = 0;

        rows.forEach(row => {
            const fileName = row.dataset.name.replace('.csv', ''); // "2026-04-03"
            const p = fileName.split('-'); // ["2026", "04", "03"]
            
            // สร้างข้อความสำหรับการค้นหาแบบไทย: "03-04-2026"
            const thaiFormat = `${p[2]}-${p[1]}-${p[0]}`; 
            
            // ตรวจสอบว่าสิ่งที่พิมพ์ อยู่ในชื่อไฟล์เดิม หรือ อยู่ในรูปแบบไทย
            const show = !q || thaiFormat.includes(q) || fileName.includes(q);
            
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        if (resultCount) {
            resultCount.textContent = `แสดง ${visible} จาก ${total} รายการ`;
        }
    });
</script>
