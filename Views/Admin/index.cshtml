@model IEnumerable<ParkingWeb.Models.ParkingState>
@{
    ViewData["Title"] = "Control Panel";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --blue:        #185FA5;
        --blue-dk:     #0C447C;
        --blue-lt:     #EFF6FF;
        --blue-bd:     #BFDBFE;
        --ink:         #111827;
        --ink-2:       #374151;
        --ink-3:       #6B7280;
        --ink-4:       #9CA3AF;
        --bg:          #F4F6F9;
        --surface:     #FAFAFA;
        --white:       #ffffff;
        --border:      #E5E7EB;
        --border-lt:   #F3F4F6;
        --green-lt:    #EAF3DE;
        --green-bd:    #C0DD97;
        --green-tx:    #3B6D11;
        --green-dot:   #639922;
        --red:         #A32D2D;
        --red-lt:      #FEF2F2;
        --red-bd:      #FECACA;
        --radius-sm:   6px;
        --radius-md:   8px;
        --radius-lg:   12px;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
    }

    /* ── Topbar ── */
    .pk-topbar {
        background: var(--white);
        border-bottom: 0.5px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        height: 54px;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .pk-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
    }

    .pk-logo {
        width: 30px;
        height: 30px;
        background: var(--blue);
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pk-logo svg {
        width: 15px;
        height: 15px;
        stroke: #fff;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pk-nav-tag {
        font-size: 11px;
        color: var(--ink-3);
        background: var(--border-lt);
        border: 0.5px solid var(--border);
        border-radius: 4px;
        padding: 2px 9px;
    }

    .pk-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--blue-lt);
        border: 0.5px solid var(--blue-bd);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        color: var(--blue);
    }

    /* ── Hero ── */
    .pk-hero {
        background: var(--white);
        border-bottom: 0.5px solid var(--border);
        padding: 28px 32px;
    }

    .pk-hero-inner {
        max-width: 1080px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .pk-crumb {
        font-size: 11px;
        color: var(--ink-4);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 6px;
    }

    .pk-crumb svg {
        width: 10px;
        height: 10px;
        stroke: var(--ink-4);
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pk-hero-title {
        font-size: 22px;
        font-weight: 600;
        color: var(--ink);
    }

    .pk-hero-sub {
        font-size: 13px;
        color: var(--ink-3);
        margin-top: 3px;
    }

    .pk-status-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--green-lt);
        border: 0.5px solid var(--green-bd);
        border-radius: 20px;
        padding: 7px 16px;
        font-size: 12px;
        color: var(--green-tx);
        font-weight: 500;
        white-space: nowrap;
    }

    .pk-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green-dot);
        flex-shrink: 0;
    }

    /* ── Content ── */
    .pk-content {
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 32px 56px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ── Card ── */
    .pk-card {
        background: var(--white);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .pk-card-head {
        padding: 14px 22px;
        border-bottom: 0.5px solid var(--border-lt);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--surface);
    }

    .pk-card-head-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pk-card-num {
        width: 22px;
        height: 22px;
        background: var(--border-lt);
        border: 0.5px solid var(--border);
        border-radius: 5px;
        font-size: 10px;
        font-weight: 500;
        color: var(--ink-3);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pk-card-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    .pk-card-meta {
        font-size: 11px;
        color: var(--ink-4);
    }

    .pk-card-body {
        padding: 22px;
    }

    /* ── Video section ── */
    .pk-video-wrapper {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        align-items: flex-start;
    }

    .pk-vbox {
        flex: 0 0 270px;
        aspect-ratio: 16 / 9;
        background: #0F172A;
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 0.5px solid var(--border);
    }

    .pk-vbox video {
        width: 100%;
        height: 100%;
        display: block;
    }

    .pk-upload-panel {
        flex: 1;
        min-width: 200px;
    }

    .pk-upload-hint {
        font-size: 12px;
        color: var(--ink-3);
        margin-bottom: 14px;
        line-height: 1.7;
    }

    .pk-file-zone {
        border: 0.5px dashed #D1D5DB;
        border-radius: var(--radius-md);
        padding: 22px;
        text-align: center;
        background: #F9FAFB;
        margin-bottom: 14px;
        transition: background 0.15s, border-color 0.15s;
        cursor: pointer;
    }

    .pk-file-zone:hover {
        background: var(--border-lt);
        border-color: var(--ink-4);
    }

    .pk-fz-icon {
        width: 34px;
        height: 34px;
        background: var(--white);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
    }

    .pk-fz-icon svg {
        width: 16px;
        height: 16px;
        stroke: var(--ink-3);
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pk-fz-label {
        font-size: 12px;
        color: var(--ink-3);
    }

    .pk-fz-label span {
        color: var(--blue);
        cursor: pointer;
        font-weight: 500;
    }

    .pk-fz-sub {
        font-size: 11px;
        color: var(--ink-4);
        margin-top: 4px;
    }

    /* Hide real file input but keep it functional */
    .pk-file-zone input[type="file"] {
        display: none;
    }

    /* ── Buttons ── */
    .btn-pk-primary {
        background: var(--blue);
        color: #fff;
        border: none;
        padding: 9px 18px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 12px;
        font-weight: 500;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.15s;
    }

    .btn-pk-primary:hover { background: var(--blue-dk); }

    .btn-pk-primary svg {
        width: 13px;
        height: 13px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    .btn-pk-sm {
        padding: 8px 14px;
    }

    .btn-pk-danger {
        color: var(--red);
        background: var(--white);
        border: 0.5px solid var(--red-bd);
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 12px;
        font-weight: 500;
        font-family: inherit;
        transition: background 0.15s;
    }

    .btn-pk-danger:hover { background: var(--red-lt); }

    .btn-pk-log {
        font-size: 12px;
        font-weight: 500;
        color: var(--blue);
        background: var(--blue-lt);
        border: 0.5px solid var(--blue-bd);
        border-radius: var(--radius-sm);
        padding: 10px 18px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s;
    }

    .btn-pk-log:hover { background: #DBEAFE; }

    .btn-pk-log svg {
        width: 13px;
        height: 13px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    /* ── GPIO rows ── */
    .pk-gpio-row {
        display: grid;
        grid-template-columns: 52px 1fr auto auto;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 0.5px solid var(--border-lt);
    }

    .pk-gpio-row:last-child { border-bottom: none; }

    .pk-thumb {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: var(--radius-md);
        border: 0.5px solid var(--border);
        background: var(--border-lt);
        flex-shrink: 0;
    }

    .pk-gpio-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    .pk-gpio-pin {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--blue);
        background: var(--blue-lt);
        border: 0.5px solid var(--blue-bd);
        border-radius: 4px;
        padding: 2px 7px;
        margin-top: 4px;
    }

    .pk-gpio-pin svg {
        width: 10px;
        height: 10px;
        stroke: var(--blue);
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    .pk-gpio-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Custom file input button */
    .pk-file-wrap {
        position: relative;
        display: inline-block;
        overflow: hidden;
    }

    .pk-file-btn {
        font-size: 11px;
        color: var(--ink-2);
        background: #F9FAFB;
        border: 0.5px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 8px 12px;
        cursor: pointer;
        white-space: nowrap;
        display: block;
        transition: background 0.15s;
        font-family: inherit;
        font-weight: 400;
    }

    .pk-file-btn:hover { background: var(--border-lt); }

    .pk-file-wrap input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    /* ── Footer bar ── */
    .pk-footer-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .pk-footer-meta {
        font-size: 11px;
        color: var(--ink-4);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pk-footer-meta svg {
        width: 12px;
        height: 12px;
        stroke: var(--ink-4);
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .pk-hero, .pk-content { padding-left: 16px; padding-right: 16px; }
        .pk-topbar { padding: 0 16px; }
        .pk-gpio-row { grid-template-columns: 44px 1fr; }
        .pk-gpio-actions { grid-column: 1 / -1; }
        .pk-vbox { flex: 0 0 100%; }
    }
</style>

<!-- Topbar -->
<div class="pk-topbar">
    <a class="pk-brand" href="#">
        <div class="pk-logo">
            <svg viewBox="0 0 24 24">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
            </svg>
        </div>
        Parking Management System
    </a>
    <div style="display:flex;align-items:center;gap:10px;">
        <span class="pk-nav-tag">Admin Panel</span>
        <div class="pk-avatar">AD</div>
    </div>
</div>

<!-- Hero -->
<div class="pk-hero">
    <div class="pk-hero-inner">
        <div>
            <div class="pk-crumb">
                Dashboard
                <svg viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3"/></svg>
                Control Panel
            </div>
            <div class="pk-hero-title">Control Panel</div>
            <div class="pk-hero-sub">Manage idle video and GPIO state images across all parking zones.</div>
        </div>
        <div class="pk-status-pill">
            <div class="pk-dot"></div>
            All systems operational
        </div>
    </div>
</div>

<!-- Content -->
<div class="pk-content">

    <!-- Card 01 — Idle Video -->
    <div class="pk-card">
        <div class="pk-card-head">
            <div class="pk-card-head-left">
                <div class="pk-card-num">01</div>
                <span class="pk-card-title">Idle State Video</span>
            </div>
            <span class="pk-card-meta">MP4 format only &middot; max 200 MB</span>
        </div>
        <div class="pk-card-body">
            <div class="pk-video-wrapper">
                <div class="pk-vbox">
                    <video controls>
                        <source src="/videos/idle.mp4?v=@DateTime.Now.Ticks" type="video/mp4">
                    </video>
                </div>
                <div class="pk-upload-panel">
                    <p class="pk-upload-hint">
                        Replace the current idle loop displayed on parking screens.
                        Upload a new MP4 file below — changes take effect immediately after saving.
                    </p>
                    <form asp-action="UpdateIdleVideo" method="post" enctype="multipart/form-data">
                        <label class="pk-file-zone" id="videoDropZone">
                            <div class="pk-fz-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                    <polyline points="17 8 12 3 7 8"/>
                                    <line x1="12" y1="3" x2="12" y2="15"/>
                                </svg>
                            </div>
                            <div class="pk-fz-label">Drop file here, or <span>browse files</span></div>
                            <div class="pk-fz-sub" id="videoFileName">Only .mp4 files are accepted</div>
                            <input type="file" name="videoFile" accept="video/mp4" required id="videoFileInput">
                        </label>
                        <button type="submit" class="btn-pk-primary">
                            <svg viewBox="0 0 24 24">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            Save Video
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 02 — GPIO State Images -->
    <div class="pk-card">
        <div class="pk-card-head">
            <div class="pk-card-head-left">
                <div class="pk-card-num">02</div>
                <span class="pk-card-title">GPIO State Images</span>
            </div>
            <span class="pk-card-meta">@Model.Count() state(s) configured</span>
        </div>
        <div class="pk-card-body" style="padding-top:0;padding-bottom:0;">
            @foreach (var item in Model)
            {
                <div class="pk-gpio-row">
                    <img src="/uploads/@item.ImagePath"
                         class="pk-thumb"
                         onerror="this.src='https://placehold.co/52x52/F3F4F6/9CA3AF?text=?'" />
                    <div>
                        <div class="pk-gpio-name">@item.StateName</div>
                        <div class="pk-gpio-pin">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                            </svg>
                            GPIO PIN @item.GpioPin
                        </div>
                    </div>
                    <div class="pk-gpio-actions">
                        <form asp-action="UpdateStateImage" method="post" enctype="multipart/form-data"
                              style="display:flex;align-items:center;gap:8px;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="pk-file-wrap">
                                <span class="pk-file-btn" id="label-@item.Id">Choose image</span>
                                <input type="file" name="imageFile" accept="image/*" required
                                       onchange="document.getElementById('label-@item.Id').textContent = this.files[0]?.name ?? 'Choose image'" />
                            </div>
                            <button type="submit" class="btn-pk-primary btn-pk-sm">Upload</button>
                        </form>
                    </div>
                    <form asp-action="DeleteStateImage" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-pk-danger"
                                onclick="return confirm('Remove this state image?')">
                            Remove
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Footer -->
    <div class="pk-footer-bar">
        <div class="pk-footer-meta">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            Last synced &middot; @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
        </div>
        <a asp-action="ViewLogs" class="btn-pk-log">
            <svg viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
            </svg>
            View 90-Day Log History
        </a>
    </div>

</div>

<script>
    // Show selected filename in the video drop zone
    document.getElementById('videoFileInput')?.addEventListener('change', function () {
        const label = document.getElementById('videoFileName');
        if (label) label.textContent = this.files[0]?.name ?? 'Only .mp4 files are accepted';
    });

    // Drag-and-drop highlight for video zone
    const zone = document.getElementById('videoDropZone');
    if (zone) {
        ['dragenter', 'dragover'].forEach(e => zone.addEventListener(e, () => zone.style.background = '#EFF6FF', false));
        ['dragleave', 'drop'].forEach(e => zone.addEventListener(e, () => zone.style.background = '', false));
    }
</script>
