@model IEnumerable<ParkingWeb.Models.ParkingState>
@{
    ViewData["Title"] = "Control Panel";

    double usedPct  = double.Parse(ViewBag.UsedPercent.ToString());
    double totalGB  = double.Parse(ViewBag.TotalSpace.ToString());
    double freeGB   = double.Parse(ViewBag.FreeSpace.ToString());
    double usedGB   = totalGB - freeGB;

    string ringColor = usedPct >= 90 ? "#ef4444"
                     : usedPct >= 75 ? "#f59e0b"
                     : usedPct >= 50 ? "#185FA5"
                     : "#22c55e";

    double r             = 24;
    double circumference = 2 * Math.PI * r;
    double dashOffset    = circumference - (usedPct / 100.0) * circumference;

}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --blue:       #2563EB;
        --blue-dk:    #1D4ED8;
        --blue-lt:    #EFF6FF;
        --blue-bd:    #BFDBFE;
        --ink:        #0F172A;
        --ink-2:      #334155;
        --ink-3:      #64748B;
        --ink-4:      #94A3B8;
        --bg:         #F8FAFC;
        --surface:    #FAFAFA;
        --white:      #ffffff;
        --border:     #E2E8F0;
        --border-lt:  #F1F5F9;
        --green-lt:   #F0FDF4;
        --green-bd:   #BBF7D0;
        --green-tx:   #166534;
        --green-dot:  #16A34A;
        --red:        #ef4444;
        --red-lt:     #FEF2F2;
        --red-bd:     #FECACA;
        --red-tx:     #991B1B;
        --radius-sm:  8px;
        --radius-md:  10px;
        --radius-lg:  14px;
    }

    body {
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-size: 14px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }

    /* ── Topbar ── */
    .pk-topbar {
        background: var(--white); border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 28px; height: 58px; position: sticky; top: 0; z-index: 100;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }
    .pk-brand { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: var(--ink); text-decoration: none; letter-spacing: -.2px; }
    .pk-logo { width: 34px; height: 34px; background: var(--blue); border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 8px rgba(37,99,235,.25); }
    .pk-logo svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .pk-nav-tag { font-size: 10px; color: var(--ink-3); background: var(--border-lt); border: 1px solid var(--border); border-radius: 6px; padding: 3px 10px; font-family: 'JetBrains Mono', monospace; font-weight: 500; letter-spacing: .3px; }
    .pk-avatar { width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(135deg, var(--blue-lt), #DBEAFE); border: 1.5px solid var(--blue-bd); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: var(--blue); }

    /* ── Hero ── */
    .pk-hero { background: var(--white); border-bottom: 1px solid var(--border); padding: 26px 32px; }
    .pk-hero-inner { max-width: 1180px; margin: 0 auto; display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
    .pk-crumb { font-size: 11px; color: var(--ink-4); display: flex; align-items: center; gap: 5px; margin-bottom: 6px; font-family: 'JetBrains Mono', monospace; font-weight: 500; }
    .pk-crumb svg { width: 9px; height: 9px; stroke: var(--ink-4); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .pk-hero-title { font-size: 24px; font-weight: 700; color: var(--ink); letter-spacing: -.4px; }
    .pk-hero-sub   { font-size: 13px; color: var(--ink-3); margin-top: 4px; }
    .pk-status-pill { display: flex; align-items: center; gap: 8px; background: var(--green-lt); border: 1px solid var(--green-bd); border-radius: 100px; padding: 8px 16px; font-size: 12px; color: var(--green-tx); font-weight: 600; white-space: nowrap; }
    .pk-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green-dot); flex-shrink: 0; position: relative; }
    .pk-dot::after { content:''; position:absolute; inset:-3px; border-radius:50%; background:rgba(22,163,74,.3); animation: pk-pulse 2s ease-out infinite; }
    @@keyframes pk-pulse { 0%{transform:scale(.8);opacity:1;} 100%{transform:scale(2);opacity:0;} }

    /* ── Content ── */
    .pk-content { max-width: 1180px; margin: 0 auto; padding: 24px 32px 56px; display: flex; flex-direction: column; gap: 18px; }

    /* ── Storage Card (multi-bar) ── */
    .pk-storage-card {
        background: var(--white); border: 1px solid var(--border);
        border-radius: var(--radius-lg); padding: 22px 26px;
        display: flex; flex-direction: column; gap: 18px;
    }
    .pk-storage-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    .pk-storage-title-row { display: flex; align-items: center; gap: 10px; }
    .pk-storage-icon { width: 38px; height: 38px; border-radius: 10px; background: var(--blue-lt); border: 1px solid var(--blue-bd); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pk-storage-icon svg { width: 18px; height: 18px; stroke: var(--blue); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .pk-storage-title { font-size: 14px; font-weight: 700; color: var(--ink); }
    .pk-storage-sub   { font-size: 11px; color: var(--ink-4); margin-top: 2px; }
    .pk-pct-badge { font-size: 22px; font-weight: 700; color: var(--ink); font-family: 'JetBrains Mono', monospace; letter-spacing: -1px; }
    .pk-pct-badge span { font-size: 13px; font-weight: 500; color: var(--ink-3); margin-left: 2px; }
    .pk-bars { display: flex; flex-direction: column; gap: 14px; }
    .pk-bar-row { display: flex; flex-direction: column; gap: 6px; }
    .pk-bar-label-row { display: flex; justify-content: space-between; align-items: center; }
    .pk-bar-label { font-size: 12px; font-weight: 500; color: var(--ink-2); display: flex; align-items: center; gap: 6px; }
    .pk-bar-label::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 3px; }
    .pk-bar-label.drive::before { background: var(--blue); }
    .pk-bar-label.logs::before  { background: #8B5CF6; }
    .pk-bar-val { font-size: 11px; color: var(--ink-4); font-family: 'JetBrains Mono', monospace; }
    .pk-bar-track { height: 10px; background: var(--border-lt); border-radius: 99px; overflow: hidden; border: 1px solid var(--border); }
    .pk-bar-fill { height: 100%; border-radius: 99px; transition: width .8s cubic-bezier(.4,0,.2,1); }
    .pk-bar-fill.drive { background: linear-gradient(90deg, #3b82f6, #2563EB); }
    .pk-bar-fill.logs  { background: linear-gradient(90deg, #a78bfa, #7C3AED); }
    .pk-stat-chips { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 4px; border-top: 1px solid var(--border-lt); }
    .pk-chip { display: flex; flex-direction: column; gap: 2px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 14px; flex: 1; min-width: 80px; }
    .pk-chip-label { font-size: 10px; color: var(--ink-4); text-transform: uppercase; letter-spacing: .5px; }
    .pk-chip-value { font-size: 15px; font-weight: 700; color: var(--ink); font-family: 'JetBrains Mono', monospace; }
    .pk-chip-unit  { font-size: 10px; color: var(--ink-4); font-weight: 400; }
    .pk-warn-badge { display: inline-flex; align-items: center; gap: 4px; background: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; border-radius: 6px; padding: 3px 8px; font-size: 10px; font-weight: 600; }

    /* ── Two-col ── */
    .pk-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        align-items: stretch;
    }
    .pk-two-col > .pk-card {
        display: flex;
        flex-direction: column;
    }

    /* ── Card ── */
    .pk-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
    .pk-card-head { padding: 14px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--border-lt); }
    .pk-card-head-left { display: flex; align-items: center; gap: 9px; }
    .pk-card-accent { width: 3px; height: 17px; border-radius: 2px; background: var(--blue); flex-shrink: 0; }
    .pk-card-accent.green { background: var(--green-dot); }
    .pk-card-num { width: 22px; height: 22px; background: var(--white); border: 1px solid var(--border); border-radius: 6px; font-size: 10px; font-weight: 700; color: var(--ink-3); display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; }
    .pk-card-title { font-size: 14px; font-weight: 700; color: var(--ink); }
    .pk-card-meta  { font-size: 11px; color: var(--ink-4); font-family: 'JetBrains Mono', monospace; font-weight: 500; }
    .pk-card-body  { padding: 20px; flex: 1; display: flex; flex-direction: column; }

    /* ── Video ── */
    .pk-vbox {
        width: 100%;
        height: 196px;
        background: #000;
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pk-vbox video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain; /* รองรับทั้ง landscape/portrait ไม่เพี้ยน */
    }
    .pk-upload-hint { font-size: 13px; color: var(--ink-3); margin: 14px 0; line-height: 1.7; }
    .pk-file-zone { border: 2px dashed var(--border); border-radius: var(--radius-md); padding: 20px; text-align: center; background: var(--bg); margin-bottom: 12px; display: block; transition: all .2s; cursor: pointer; }
    .pk-file-zone:hover { background: var(--blue-lt); border-color: var(--blue-bd); }
    .pk-fz-icon { width: 36px; height: 36px; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; }
    .pk-fz-icon svg { width: 16px; height: 16px; stroke: var(--ink-3); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .pk-fz-label { font-size: 13px; color: var(--ink-3); }
    .pk-fz-label span { color: var(--blue); cursor: pointer; font-weight: 600; }
    .pk-fz-sub { font-size: 11px; color: var(--ink-4); margin-top: 4px; }
    .pk-file-zone input[type="file"] { display: none; }

    /* ── Buttons ── */
    .btn-pk-primary { background: var(--blue); color: #fff; border: none; padding: 10px 18px; border-radius: var(--radius-sm); cursor: pointer; font-size: 13px; font-weight: 600; font-family: inherit; display: inline-flex; align-items: center; gap: 6px; transition: all .15s; box-shadow: 0 1px 3px rgba(37,99,235,.2); }
    .btn-pk-primary:hover { background: var(--blue-dk); box-shadow: 0 4px 12px rgba(37,99,235,.25); }
    .btn-pk-primary svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .btn-pk-sm { padding: 7px 12px; font-size: 12px; }
    .btn-pk-danger { color: var(--red-tx); background: var(--white); border: 1px solid var(--red-bd); padding: 7px 12px; border-radius: var(--radius-sm); cursor: pointer; font-size: 12px; font-weight: 600; font-family: inherit; transition: all .15s; }
    .btn-pk-danger:hover { background: var(--red-lt); }
    .btn-pk-log { font-size: 13px; font-weight: 600; color: var(--blue); background: var(--blue-lt); border: 1px solid var(--blue-bd); border-radius: var(--radius-sm); padding: 10px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; transition: all .15s; }
    .btn-pk-log:hover { background: #DBEAFE; }
    .btn-pk-log svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* ── Mute Toggle ── */
    .pk-btn-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 2px; }
    .btn-pk-mute {
        background: #38BDF8; color: #ffffff;
        border: 1.5px solid #0EA5E9;
        padding: 10px 18px; border-radius: var(--radius-sm);
        cursor: pointer; font-size: 13px; font-weight: 600; font-family: inherit;
        display: inline-flex; align-items: center; gap: 6px;
        transition: all .2s ease;
        position: relative; overflow: hidden;
    }
    .btn-pk-mute:hover { filter: brightness(.93); box-shadow: 0 4px 12px rgba(0,0,0,.12); }
    .btn-pk-mute svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: all .2s; }
    .btn-pk-mute.is-muted {
        background: #EF4444; color: #ffffff;
        border-color: #DC2626;
    }
    .btn-pk-mute .mute-label { transition: opacity .15s; }

    /* ── GPIO State Image rows ── */
    .pk-gpio-row { display: grid; grid-template-columns: 46px 1fr auto auto; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border-lt); }
    .pk-gpio-row:last-child { border-bottom: none; }
    .pk-thumb { width: 46px; height: 46px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--border-lt); }
    .pk-gpio-name { font-size: 14px; font-weight: 600; color: var(--ink); }
    .pk-gpio-pin { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: var(--blue); background: var(--blue-lt); border: 1px solid var(--blue-bd); border-radius: 6px; padding: 3px 8px; margin-top: 4px; font-family: 'JetBrains Mono', monospace; font-weight: 500; }
    .pk-gpio-pin svg { width: 9px; height: 9px; stroke: var(--blue); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .pk-gpio-actions { display: flex; align-items: center; gap: 8px; }
    .pk-file-wrap { position: relative; display: inline-block; overflow: hidden; }
    .pk-file-btn { font-size: 12px; color: var(--ink-2); background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 7px 12px; cursor: pointer; white-space: nowrap; display: block; transition: all .15s; font-family: inherit; font-weight: 500; }
    .pk-file-btn:hover { background: var(--border-lt); }
    .pk-file-wrap input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }

    /* ── Kiosk Rotation ── */
    .pk-kiosk-layout {
        display: flex; flex-direction: column; align-items: center; gap: 20px; flex: 1; justify-content: center;
    }
    .pk-kiosk-preview {
        display: flex; align-items: center; justify-content: center; width: 100%;
    }
    .pk-kiosk-controls {
        width: 100%; display: flex; flex-direction: column;
    }

    .pk-screen-stage { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 20px 32px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-md); width: 100%; }
    .pk-screen-frame { position: relative; width: 88px; height: 56px; border: 2.5px solid var(--ink-2); border-radius: 7px; background: linear-gradient(135deg, var(--blue-lt) 0%, #DBEAFE 100%); display: flex; align-items: center; justify-content: center; transition: all .5s cubic-bezier(.4,0,.2,1); overflow: visible; }
    .pk-screen-frame::after { content: ''; position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); width: 20px; height: 5px; background: var(--ink-2); border-radius: 0 0 3px 3px; }
    .pk-screen-stand { width: 28px; height: 4px; background: var(--ink-2); border-radius: 2px; margin-top: 4px; }
    .pk-screen-arrow { transition: transform .5s cubic-bezier(.4,0,.2,1); }
    .pk-screen-arrow svg { width: 26px; height: 26px; stroke: var(--blue); fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 5px rgba(37,99,235,.25)); }
    .pk-orient-label { font-size: 11px; font-weight: 600; color: var(--ink-3); font-family: 'JetBrains Mono', monospace; text-align: center; margin-top: 2px; }

    .pk-rot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .pk-rot-btn { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 12px 10px; border: 1.5px solid var(--border); border-radius: var(--radius-md); background: var(--white); cursor: pointer; transition: all .2s ease; font-family: 'JetBrains Mono', monospace; }
    .pk-rot-btn:hover { border-color: var(--blue-bd); background: var(--blue-lt); }
    .pk-rot-btn.active { border-color: var(--blue); background: var(--blue-lt); box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .pk-rot-btn svg { width: 22px; height: 22px; stroke: var(--ink-3); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: stroke .2s; }
    .pk-rot-btn:hover svg, .pk-rot-btn.active svg { stroke: var(--blue); }
    .pk-rot-btn span { font-size: 11px; font-weight: 600; color: var(--ink-3); transition: color .2s; }
    .pk-rot-btn:hover span, .pk-rot-btn.active span { color: var(--blue); }
    .pk-rot-check { position: absolute; top: 5px; right: 5px; width: 15px; height: 15px; border-radius: 50%; background: var(--blue); display: none; align-items: center; justify-content: center; }
    .pk-rot-check svg { width: 9px; height: 9px; stroke: #fff; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
    .pk-rot-btn.active .pk-rot-check { display: flex; }

    .pk-apply-btn { width: 100%; background: var(--blue); color: #fff; border: none; padding: 11px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px; transition: all .15s; font-family: inherit; margin-top: 12px; box-shadow: 0 2px 8px rgba(37,99,235,.2); }
    .pk-apply-btn:hover { background: var(--blue-dk); box-shadow: 0 4px 14px rgba(37,99,235,.25); }
    .pk-apply-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* ── Footer ── */
    .pk-footer-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; padding-top: 6px; }
    .pk-footer-meta { font-size: 12px; color: var(--ink-4); display: flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; font-weight: 500; }
    .pk-footer-meta svg { width: 13px; height: 13px; stroke: var(--ink-4); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

    /* ── Responsive ── */
    @@media (max-width: 900px) {
        .pk-stat-row { grid-template-columns: 1fr; }
        .pk-info-row { grid-template-columns: 1fr; }
        .pk-two-col  { grid-template-columns: 1fr; }
    }
    @@media (max-width: 640px) {
        .pk-topbar  { padding: 0 16px; height: 54px; }
        .pk-hero    { padding: 20px 16px; }
        .pk-content { padding: 16px 16px 48px; }
        .pk-stat-row { gap: 10px; }
        .pk-info-row { gap: 10px; }
        .pk-stat  { padding: 14px; gap: 10px; }
        .pk-stat-value { font-size: 18px; }
        .pk-storage-card { padding: 14px; gap: 12px; }
        .pk-hero-title { font-size: 20px; }
        .pk-card-body { padding: 16px; }

        /* GPIO rows: stack cleanly */
        .pk-gpio-row { grid-template-columns: 44px 1fr; gap: 10px; }
        .pk-gpio-actions { grid-column: 1 / -1; }
.pk-gpio-actions form { width: 100%; flex-wrap: nowrap; }
        .pk-file-wrap { flex: 1; min-width: 0; }
        .pk-file-btn { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 44px; display: flex; align-items: center; }
        .pk-gpio-row > form:last-child { grid-column: 1 / -1; text-align: right; }
        .btn-pk-sm { min-height: 44px; padding: 10px 14px; }
        .btn-pk-danger { min-height: 44px; padding: 10px 14px; }

        /* Upload zone: hide drag text on mobile, show tap text */
        .pk-fz-label .pk-fz-drag { display: none; }
        .pk-file-zone { padding: 18px 12px; }

        /* Buttons row: stack on very small screens */
        .pk-btn-row { flex-wrap: wrap; }
        .btn-pk-mute, .pk-btn-row .btn-pk-primary { flex: 1; justify-content: center; min-height: 48px; }

        /* Prevent iOS font zoom on inputs */
        .pk-search-input,
        input[type="file"],
        select { font-size: 16px !important; }

        /* Rotation buttons: bigger tap area */
        .pk-rot-btn { padding: 14px 10px; }

        .pk-screen-frame { width: 72px; height: 46px; }
        .pk-screen-stage { padding: 16px 20px; }
        .pk-kiosk-layout { gap: 14px; }
        .pk-footer-bar { flex-direction: column; align-items: flex-start; }
    }
    @@media (max-width: 420px) {
        .pk-nav-tag { display: none; }
        .pk-hero-sub { font-size: 12px; }
    }

    /* Kiosk helpers */
    body.rotate-90  { transform: rotate(90deg);  transform-origin: top left; width: 100vh; height: 100vw; overflow-x: hidden; position: absolute; top: 0; left: 100%; }
    body.rotate-180 { transform: rotate(180deg); }
    body.rotate-270 { transform: rotate(270deg); transform-origin: top left; width: 100vh; height: 100vw; overflow-x: hidden; position: absolute; top: 100%; left: 0; }
</style>

<!-- ── Topbar ── -->
<div class="pk-topbar">
    <a class="pk-brand" href="#">
        <div class="pk-logo">
            <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        </div>
        Parking Management System
    </a>
    <div style="display:flex;align-items:center;gap:10px;">
        <span class="pk-nav-tag">Admin Panel</span>
        <div class="pk-avatar">AD</div>
    </div>
</div>

<!-- ── Hero ── -->
<div class="pk-hero">
    <div class="pk-hero-inner">
        <div>
            <div class="pk-crumb">
                Dashboard
                <svg viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3"/></svg>
                Control Panel
            </div>
            <div class="pk-hero-title">Control Panel</div>
            <div class="pk-hero-sub">Manage idle video, GPIO state images and kiosk display across all parking zones.</div>
        </div>
        <div class="pk-status-pill">
            <div class="pk-dot"></div>
            All systems operational
        </div>
    </div>
</div>

<!-- ── Content ── -->
<div class="pk-content">

    @{
        double logPct    = double.Parse(ViewBag.LogUsedPct.ToString());
        double driveBarW = Math.Min(usedPct, 100);
        double logBarW   = Math.Min(logPct, 100);
    }
    <div class="pk-storage-card">
        <div class="pk-storage-header">
            <div class="pk-storage-title-row">
                <div class="pk-storage-icon">
                    <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                </div>
                <div>
                    <div class="pk-storage-title">Storage Overview</div>
                    <div class="pk-storage-sub">SD Card · Log Files</div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="pk-pct-badge" style="color:@ringColor;">@ViewBag.UsedPercent<span>% used</span></div>
                @if (freeGB < 1.0) { <div class="pk-warn-badge">⚠️ พื้นที่ใกล้เต็ม!</div> }
            </div>
        </div>

        <div class="pk-bars">
            <div class="pk-bar-row">
                <div class="pk-bar-label-row">
                    <span class="pk-bar-label drive">SD Card Used</span>
                    <span class="pk-bar-val">@usedGB.ToString("F1") GB / @totalGB GB</span>
                </div>
                <div class="pk-bar-track">
                    <div class="pk-bar-fill drive" style="width:@(driveBarW.ToString("F1"))%; background:linear-gradient(90deg,@ringColor,@ringColor);"></div>
                </div>
            </div>
            <div class="pk-bar-row">
                <div class="pk-bar-label-row">
                    <span class="pk-bar-label logs">Log Files</span>
                    <span class="pk-bar-val">@ViewBag.TotalLogSize MB &nbsp;·&nbsp; @ViewBag.LogUsedPct% of drive</span>
                </div>
                <div class="pk-bar-track">
                    <div class="pk-bar-fill logs" style="width:@(logBarW.ToString("F2"))%;"></div>
                </div>
            </div>
        </div>

        <div class="pk-stat-chips">
            <div class="pk-chip">
                <span class="pk-chip-label">Total Drive</span>
                <span class="pk-chip-value">@totalGB <span class="pk-chip-unit">GB</span></span>
            </div>
            <div class="pk-chip">
                <span class="pk-chip-label">Used</span>
                <span class="pk-chip-value">@usedGB.ToString("F1") <span class="pk-chip-unit">GB</span></span>
            </div>
            <div class="pk-chip">
                <span class="pk-chip-label">Free</span>
                <span class="pk-chip-value">@ViewBag.FreeSpace <span class="pk-chip-unit">GB</span></span>
            </div>
            <div class="pk-chip">
                <span class="pk-chip-label">Log Size</span>
                <span class="pk-chip-value">@ViewBag.TotalLogSize <span class="pk-chip-unit">MB</span></span>
            </div>
        </div>
    </div>

    <div class="pk-two-col">

        <!-- Card 01: Idle Video -->
        <div class="pk-card">
            <div class="pk-card-head">
                <div class="pk-card-head-left">
                    <div class="pk-card-accent"></div>
                    <div class="pk-card-num">01</div>
                    <span class="pk-card-title">Idle State Video</span>
                </div>
                <span class="pk-card-meta">MP4 · max 200 MB</span>
            </div>
            <div class="pk-card-body">
                <div class="pk-vbox">
                    <video controls>
                        <source src="/videos/idle.mp4?v=@DateTime.Now.Ticks" type="video/mp4">
                    </video>
                </div>
                <p class="pk-upload-hint">
                    Replace the current idle loop displayed on parking screens.
                    Upload a new MP4 file below — changes take effect immediately after saving.
                </p>
                <form asp-action="UpdateIdleVideo" method="post" enctype="multipart/form-data">
                    <label class="pk-file-zone" id="videoDropZone">
                        <div class="pk-fz-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/>
                                <line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                        </div>
                        <div class="pk-fz-label"><span class="pk-fz-drag">Drop file here, or </span><span>browse files</span></div>
                        <div class="pk-fz-sub" id="videoFileName">Only .mp4 files are accepted</div>
                        <input type="file" name="videoFile" accept="video/mp4" required id="videoFileInput">
                    </label>
                    <div class="pk-btn-row">
                        <button type="submit" class="btn-pk-primary">
                            <svg viewBox="0 0 24 24">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            Save Video
                        </button>
                        <button type="button" class="btn-pk-mute" id="muteToggleBtn" onclick="toggleKioskMute()">
                            <svg id="muteIcon" viewBox="0 0 24 24">
                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                                <path d="M19.07 4.93a10 10 0 010 14.14"/>
                                <path d="M15.54 8.46a5 5 0 010 7.07"/>
                            </svg>
                            <span class="mute-label" id="muteLabelText">Sound On</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Card 02: Kiosk Display Rotation -->
        <div class="pk-card">
            <div class="pk-card-head">
                <div class="pk-card-head-left">
                    <div class="pk-card-accent"></div>
                    <div class="pk-card-num">02</div>
                    <span class="pk-card-title">Kiosk Display Rotation</span>
                </div>
                <span class="pk-card-meta">Screen orientation</span>
            </div>
            <div class="pk-card-body">
                <div class="pk-kiosk-layout">

                    <!-- Screen preview -->
                    <div class="pk-kiosk-preview">
                        <div class="pk-screen-stage">
                            <div id="screenFrame" class="pk-screen-frame">
                                <div id="screenArrow" class="pk-screen-arrow">
                                    <svg viewBox="0 0 24 24">
                                        <line x1="12" y1="19" x2="12" y2="5"/>
                                        <polyline points="5 12 12 5 19 12"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="pk-screen-stand"></div>
                            <div id="orientLabel" class="pk-orient-label">0° — Landscape</div>
                        </div>
                    </div>

                    <!-- 2×2 rotation buttons -->
                    <div class="pk-kiosk-controls">
                        <div class="pk-rot-grid">

                            <button type="button" class="pk-rot-btn active"
                                    data-deg="0" data-label="Landscape" data-arrow-rotate="0"
                                    onclick="selectRot(this)">
                                <div class="pk-rot-check"><svg viewBox="0 0 8 8"><polyline points="1 4 3 6 7 2"/></svg></div>
                                <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="13" rx="2"/><line x1="10" y1="19" x2="14" y2="21"/><line x1="10" y1="21" x2="14" y2="21"/></svg>
                                <span>0°</span>
                            </button>

                            <button type="button" class="pk-rot-btn"
                                    data-deg="90" data-label="Portrait" data-arrow-rotate="90"
                                    onclick="selectRot(this)">
                                <div class="pk-rot-check"><svg viewBox="0 0 8 8"><polyline points="1 4 3 6 7 2"/></svg></div>
                                <svg viewBox="0 0 24 24"><rect x="6" y="2" width="13" height="20" rx="2"/></svg>
                                <span>90°</span>
                            </button>

                            <button type="button" class="pk-rot-btn"
                                    data-deg="180" data-label="Flipped" data-arrow-rotate="180"
                                    onclick="selectRot(this)">
                                <div class="pk-rot-check"><svg viewBox="0 0 8 8"><polyline points="1 4 3 6 7 2"/></svg></div>
                                <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="13" rx="2"/><polyline points="8 6 12 2 16 6"/></svg>
                                <span>180°</span>
                            </button>

                            <button type="button" class="pk-rot-btn"
                                    data-deg="270" data-label="Portrait (L)" data-arrow-rotate="270"
                                    onclick="selectRot(this)">
                                <div class="pk-rot-check"><svg viewBox="0 0 8 8"><polyline points="1 4 3 6 7 2"/></svg></div>
                                <svg viewBox="0 0 24 24"><rect x="6" y="2" width="13" height="20" rx="2"/><polyline points="6 8 2 12 6 16"/></svg>
                                <span>270°</span>
                            </button>

                        </div>

                        <button type="button" class="pk-apply-btn" onclick="applyKioskRotation()">
                            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                            Update Kiosk Screen
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div><!-- /pk-two-col -->

    <!-- Card 03: GPIO State Images -->
    <div class="pk-card">
        <div class="pk-card-head">
            <div class="pk-card-head-left">
                <div class="pk-card-accent"></div>
                <div class="pk-card-num">03</div>
                <span class="pk-card-title">GPIO State Images</span>
            </div>
            <span class="pk-card-meta">@Model.Count() state(s) configured</span>
        </div>
        <div class="pk-card-body" style="padding-top:0;padding-bottom:0;">
            @foreach (var item in Model)
            {
                <div class="pk-gpio-row">
                    <img src="/uploads/@item.ImagePath" class="pk-thumb"
                         onerror="this.src='https://placehold.co/44x44/F3F4F6/9CA3AF?text=?'" />
                    <div>
                        <div class="pk-gpio-name">@item.StateName</div>
                        <div class="pk-gpio-pin">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                            </svg>
                            GPIO PIN @item.GpioPin
                        </div>
                    </div>
                    <div class="pk-gpio-actions">
                        <form asp-action="UpdateStateImage" method="post" enctype="multipart/form-data"
                              style="display:flex;align-items:center;gap:6px;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="pk-file-wrap">
                                <span class="pk-file-btn" id="label-@item.Id">Choose image</span>
                                <input type="file" name="imageFile" accept="image/*" required
                                       onchange="document.getElementById('label-@item.Id').textContent = this.files[0]?.name ?? 'Choose image'" />
                            </div>
                            <button type="submit" class="btn-pk-primary btn-pk-sm">Upload</button>
                        </form>
                    </div>
                    <form asp-action="DeleteStateImage" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-pk-danger"
                                onclick="return confirm('Remove this state image?')">Remove</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ── Footer ── -->
    <div class="pk-footer-bar">
        <div class="pk-footer-meta">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            Last synced &middot; @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
        </div>
        <a asp-action="ViewLogs" class="btn-pk-log">
            <svg viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            View 90-Day Log History
        </a>
    </div>
    

    
</div><!-- /pk-content -->

<script>
    // ── Mute Toggle ──
    let kioskMuted = false;

    // sync ปุ่มกับ state จาก server ตอนโหลดหน้า
    fetch('/Admin/GetMuteState')
        .then(r => r.json())
        .then(data => { kioskMuted = data.muted; updateMuteBtn(data.muted); });

    function toggleKioskMute() {
        kioskMuted = !kioskMuted;
        updateMuteBtn(kioskMuted);
        fetch(`/Admin/SetMute?muted=${kioskMuted}`, { method: 'POST' });
    }

    function updateMuteBtn(muted) {
        const btn   = document.getElementById('muteToggleBtn');
        const icon  = document.getElementById('muteIcon');
        const label = document.getElementById('muteLabelText');
        if (muted) {
            btn.classList.add('is-muted');
            label.textContent = 'Muted';
            icon.innerHTML = `
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                <line x1="23" y1="9" x2="17" y2="15"/>
                <line x1="17" y1="9" x2="23" y2="15"/>`;
        } else {
            btn.classList.remove('is-muted');
            label.textContent = 'Sound On';
            icon.innerHTML = `
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                <path d="M19.07 4.93a10 10 0 010 14.14"/>
                <path d="M15.54 8.46a5 5 0 010 7.07"/>`;
        }
    }

    // ── Video upload ──
    document.getElementById('videoFileInput')?.addEventListener('change', function () {
        const label = document.getElementById('videoFileName');
        if (label) label.textContent = this.files[0]?.name ?? 'Only .mp4 files are accepted';
    });
    const zone = document.getElementById('videoDropZone');
    if (zone) {
        ['dragenter','dragover'].forEach(e => zone.addEventListener(e, () => zone.style.background = '#EFF6FF'));
        ['dragleave','drop'].forEach(e => zone.addEventListener(e, () => zone.style.background = ''));
    }

    // ── Kiosk Rotation ──
    let currentDeg = 0;

    function selectRot(btn) {
        currentDeg = parseInt(btn.dataset.deg);
        const label    = btn.dataset.label;
        const arrowRot = parseInt(btn.dataset.arrowRotate);
        const frame    = document.getElementById('screenFrame');
        const arrow    = document.getElementById('screenArrow');
        const orientLbl= document.getElementById('orientLabel');
        const statVal  = document.getElementById('stat-rot-val');

        arrow.style.transform = `rotate(${arrowRot}deg)`;
        orientLbl.textContent = `${currentDeg}° — ${label}`;
        if (statVal) statVal.textContent = `${currentDeg}°`;

        if (currentDeg === 90 || currentDeg === 270) {
            frame.style.width = '56px'; frame.style.height = '88px'; frame.style.borderRadius = '5px 5px 6px 6px';
        } else {
            frame.style.width = '88px'; frame.style.height = '56px'; frame.style.borderRadius = '6px';
        }

        document.querySelectorAll('.pk-rot-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    function applyKioskRotation() {
        // 1. บันทึกไว้ในเครื่องตัวเองก่อน
        localStorage.setItem('screenRotation', currentDeg);
        
        // 2. 🚀 ส่งคำสั่งไปที่ Server เพื่อให้ Server บอก Kiosk ให้หมุน (สำคัญมาก!)
        fetch(`/Admin/SaveRotation?degree=${currentDeg}`, { method: 'POST' })
            .then(response => {
                if (response.ok) {
                    // แสดง UI ว่าบันทึกสำเร็จ
                    const btn  = document.querySelector('.pk-apply-btn');
                    const orig = btn.innerHTML;
                    btn.style.background = '#22c55e';
                    btn.innerHTML = '<svg viewBox="0 0 24 24" width="13" height="13" stroke="white" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Saved & Broadcasted!';
                    setTimeout(() => { btn.style.background = ''; btn.innerHTML = orig; }, 2000);
                }
            });
    }

    // Restore saved rotation on load
    (function () {
        const saved = parseInt(localStorage.getItem('screenRotation') || '0');
        const btn   = document.querySelector(`.pk-rot-btn[data-deg="${saved}"]`);
        if (btn) selectRot(btn);
    })();


</script>
