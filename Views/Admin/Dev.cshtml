            Dev Mode Active
        </div>
    </div>
</div>

<!-- ── Content ── -->
<div class="pk-content">

    <!-- Card 01: GPIO Hardware Simulation -->
    <div class="pk-card">
        <div class="pk-card-head">
            <div class="pk-card-head-left">
                <div class="pk-card-icon green">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                </div>
                <div>
                    <div class="pk-card-title">GPIO Simulation</div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:14px;">
                <span class="pk-card-meta">@monitorPins.Length pins · send HIGH / LOW signal</span>
                <div class="mode-toggle">
                    <button class="mode-btn simulator" id="modeBtnSimulator" onclick="setSimulatorMode(true)">
                        <span class="dot"></span> Simulator
                    </button>
                    <button class="mode-btn normal" id="modeBtnNormal" onclick="setSimulatorMode(false)">
                        <span class="dot"></span> Normal
                    </button>
                </div>
            </div>
        </div>
        <div class="pk-card-body">
            <div class="sim-banner" id="simBanner">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                Simulator Mode เปิดอยู่ — ระบบไม่รับสัญญาณ GPIO จริง กดปุ่ม HIGH/LOW ด้านล่างเพื่อเปลี่ยนภาพหน้าจอ Kiosk ได้ทันที
            </div>
            <div class="pin-grid" id="simPinGrid">
                @foreach (var pin in monitorPins)
                {
                    var state = Model.FirstOrDefault(s => s.GpioPin == pin);
                    <div class="pin-card" id="sim-card-@pin">
                        <div class="pin-top">
                            <div class="pin-number">GPIO @pin</div>
                        </div>
                        <div class="pin-state-row">
                            <div class="pin-state-dot" id="sim-dot-@pin"></div>
                            <span class="pin-state-label" id="sim-label-@pin">— waiting</span>
                        </div>
                        <div class="btn-group">
                            <button class="dev-btn btn-high" onclick="triggerPin(@pin, true)">
                                <svg viewBox="0 0 12 12"><polyline points="2 8 6 4 10 8"/></svg>
                                HIGH
                            </button>
                            <button class="dev-btn btn-low" onclick="triggerPin(@pin, false)">
                                <svg viewBox="0 0 12 12"><polyline points="2 4 6 8 10 4"/></svg>
                                LOW
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="pk-two-col">

        <!-- Card 02: GPIO Live Monitor -->
        <div class="pk-card">
            <div class="pk-card-head">
                <div class="pk-card-head-left">
                    <div class="pk-card-icon blue">
                        <svg viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    </div>
                    <div>
                        <div class="pk-card-title">Live Monitor</div>
                    </div>
                </div>
                <span id="connection-status" class="pk-conn-badge off">ไม่ได้เชื่อมต่อ</span>
            </div>
            <div class="pk-card-body">
                <div class="monitor-grid">
                    @foreach (var pin in monitorPins)
                    {
                        var ms = Model.FirstOrDefault(s => s.GpioPin == pin);
                        <div id="dev-pin-@pin" class="monitor-item">
                            <div class="monitor-led-wrap">
                                <div class="monitor-led-ring"></div>
                                <div class="monitor-led"></div>
                            </div>
                            <span class="monitor-pin">GPIO @pin</span>
                            <span class="monitor-name">GPIO @pin</span>
                        </div>
                    }
                </div>
                <div class="monitor-legend">
                    <div class="legend-item">
                        <div class="legend-dot" style="background:var(--green);box-shadow:0 0 6px rgba(34,197,94,.5);"></div>
                        Car Detected
                    </div>
                    <div class="legend-item">
                        <div class="legend-dot" style="background:var(--ink-4);"></div>
                        Idle
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 03: Activity Terminal -->
        <div class="pk-card">
            <div class="pk-card-head">
                <div class="pk-card-head-left">
                    <div class="pk-card-icon amber">
                        <svg viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                    </div>
                    <div>
                        <div class="pk-card-title">Activity Terminal</div>
                    </div>
                </div>
                <span class="pk-card-meta">trigger log</span>
            </div>
            <div class="pk-card-body" style="padding-bottom:16px;">
                <div class="dev-terminal" id="terminal">
                    <div class="log-entry boot"><span class="ts">[เริ่มต้น]</span> ระบบพร้อมทำงาน · รอสัญญาณ GPIO...</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Card 04: Raw GPIO Readings -->
    <div class="pk-card">
        <div class="pk-card-head">
            <div class="pk-card-head-left">
                <div class="pk-card-icon purple">
                    <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <div>
                    <div class="pk-card-title">สัญญาณ GPIO แบบ Real-time</div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <span class="pk-card-meta">อัพเดตทุก ~1 วินาที</span>
                <span id="raw-badge" class="pk-conn-badge off">รอสัญญาณ...</span>
            </div>
        </div>
        <div class="pk-card-body" style="padding:0;">
            <div class="raw-table-wrap">
            <table class="raw-table">
                <thead>
                    <tr>
                        <th>ขา GPIO</th>
                        <th>สัญญาณปัจจุบัน</th>
                        <th>สัญญาณตอนไม่มีรถ</th>
                        <th>สถานะ</th>
                        <th>ตรวจจับรถเมื่อ</th>
                        <th>กำหนดค่าตอนไม่มีรถ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pin in monitorPins)
                    {
                        var s = Model.FirstOrDefault(x => x.GpioPin == pin);
                        <tr id="raw-row-@pin">
                            <td>
                                <div class="raw-pin-cell">
                                    <span class="raw-pin-num">@pin</span>
                                </div>
                            </td>
                            <td id="raw-val-@pin"><span class="raw-val waiting">— รอ...</span></td>
                            <td id="raw-idle-@pin"><span class="raw-val waiting">— รอ...</span></td>
                            <td id="raw-status-@pin"><span class="raw-status not-trigger">—</span></td>
                            <td id="raw-hint-@pin"></td>
                            <td>
                                <div class="cfg-btn-wrap">
                                    <button class="cfg-btn set-high" onclick="setBaseline(@pin, true)"  title="ตั้งค่าว่าตอนไม่มีรถ สัญญาณจะสูง">ว่าง = สูง (HIGH)</button>
                                    <button class="cfg-btn set-low"  onclick="setBaseline(@pin, false)" title="ตั้งค่าว่าตอนไม่มีรถ สัญญาณจะต่ำ">ว่าง = ต่ำ (LOW)</button>
                                    <button class="cfg-btn set-auto" id="cfg-auto-@pin" onclick="clearBaseline(@pin)" title="ให้ระบบตรวจจับเองอัตโนมัติ" style="display:none;">↺ คืนค่าอัตโนมัติ</button>
                                    <span class="cfg-manual-badge" id="cfg-badge-@pin" style="display:none;">กำหนดเอง</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <!-- ── Footer ── -->
    <div class="pk-footer-bar">
        <div class="pk-footer-meta">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Session · @DateTime.Now.ToString("dd MMM yyyy HH:mm")
        </div>
        <a asp-action="Index" class="btn-back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Admin Panel
        </a>
    </div>

</div>

<script src="~/js/signalr.min.js"></script>
<script>
    // ── Simulator / Normal Mode ──
    const modeBtnSimulator = document.getElementById('modeBtnSimulator');
    const modeBtnNormal    = document.getElementById('modeBtnNormal');
    const simBanner        = document.getElementById('simBanner');

    function applySimulatorMode(enabled) {
        modeBtnSimulator.classList.toggle('active', enabled);
        modeBtnNormal.classList.toggle('active', !enabled);
        simBanner.classList.toggle('show', enabled);
        document.getElementById('simPinGrid').classList.toggle('is-locked', !enabled);
    }

    async function setSimulatorMode(enabled) {
        try {
            const res = await fetch(`/Admin/SetSimulatorMode?enabled=${enabled}`, { method: 'POST' });
            if (!res.ok) { alert('Failed to set mode'); return; }
            const data = await res.json();
            applySimulatorMode(data.enabled);

            const time = new Date().toLocaleTimeString();
            const log  = document.createElement('div');
            log.className = 'log-entry';
            log.innerHTML = data.enabled
                ? `<span class="ts">[${time}]</span> เปิด <span style="color:#7c3aed;font-weight:700;">Simulator Mode</span> · สั่งภาพได้ด้วยปุ่ม HIGH/LOW`
                : `<span class="ts">[${time}]</span> กลับสู่ <span style="color:#16a34a;font-weight:700;">Normal Mode</span> · รอสัญญาณ GPIO จริง`;
            document.getElementById('terminal').prepend(log);
        } catch (err) {
            console.error('Failed to set simulator mode', err);
        }
    }

    fetch('/Admin/GetSimulatorMode')
        .then(r => r.json())
        .then(d => applySimulatorMode(d.enabled));

    // ── GPIO Simulation ──
    async function triggerPin(pin, isActive) {
        const terminal = document.getElementById('terminal');
        const time     = new Date().toLocaleTimeString();
        const sigLabel = isActive ? 'HIGH' : 'LOW';
        const sigColor = isActive ? '#16a34a' : '#dc2626';

        try {
            const response = await fetch(`/Admin/ManualTrigger?pin=${pin}&isActive=${isActive}`, { method: 'POST' });
            const data = response.ok ? await response.json() : null;

            if (response.ok && data?.ignored) {
                const log = document.createElement('div');
                log.className = 'log-entry err';
                log.innerHTML = `<span class="ts">[${time}]</span> ⚠ GPIO <span style="color:#2563eb;">${pin}</span> → ${sigLabel} ถูกข้าม — ต้องเปิด <span style="color:#7c3aed;font-weight:700;">Simulator Mode</span> ก่อน`;
                terminal.prepend(log);
                return;
            }

            // update sim card dot
            const dot   = document.getElementById('sim-dot-' + pin);
            const label = document.getElementById('sim-label-' + pin);
            if (dot)   { dot.className = 'pin-state-dot ' + (isActive ? 'is-high' : 'is-low'); }
            if (label) { label.textContent = sigLabel; label.style.color = sigColor; }

            const log = document.createElement('div');
            log.className = response.ok ? 'log-entry' : 'log-entry err';
            if (response.ok && data) {
                const carStatus = data.hasCar
                    ? `<span style="color:#16a34a;font-weight:700;">ตรวจพบรถ</span>`
                    : `<span style="color:#64748b;">ไม่มีรถ (ว่าง)</span>`;
                log.innerHTML = `<span class="ts">[${time}]</span> GPIO <span style="color:#2563eb;">${pin}</span> → <span style="color:${sigColor};font-weight:700;">${sigLabel}</span> · ${carStatus}`;
            } else {
                log.innerHTML = `<span class="ts">[${time}]</span> ❌ GPIO ${pin} ส่งสัญญาณไม่สำเร็จ`;
            }
            terminal.prepend(log);
        } catch (err) {
            console.error("Trigger failed", err);
        }
    }

    // ── SignalR ──
    const statusBadge = document.getElementById('connection-status');

    const devConnection = new signalR.HubConnectionBuilder()
        .withUrl("/parkingHub")
        .withAutomaticReconnect()
        .build();

    devConnection.on("ReceiveStatus", (imagePath, hasCar, activePin) => {
        document.querySelectorAll('.monitor-item').forEach(el => el.classList.remove('active'));
        if (hasCar && activePin !== -1) {
            document.getElementById('dev-pin-' + activePin)?.classList.add('active');
        }
    });

    devConnection.on("SetSimulatorMode", (enabled) => {
        applySimulatorMode(enabled);
    });

    // ── Raw GPIO Readings ──
    devConnection.on("RawPinValues", (pins) => {
        document.getElementById('raw-badge').textContent = 'กำลังรับสัญญาณ';
        document.getElementById('raw-badge').className   = 'pk-conn-badge live';

        pins.forEach(({ pin, isHigh, idleIsHigh, isManual }) => {
            // สัญญาณปัจจุบัน
            const valCell = document.getElementById('raw-val-' + pin);
            if (valCell) valCell.innerHTML = isHigh
                ? `<span class="raw-val is-high"><span class="dot"></span>สูง (HIGH)</span>`
                : `<span class="raw-val is-low"><span class="dot"></span>ต่ำ (LOW)</span>`;

            // สัญญาณตอนไม่มีรถ
            const idleCell = document.getElementById('raw-idle-' + pin);
            if (idleCell) {
                const badge = isManual ? ` <span class="cfg-manual-badge">กำหนดเอง</span>` : '';
                idleCell.innerHTML = idleIsHigh
                    ? `<span class="raw-val is-high" style="font-size:11px;"><span class="dot"></span>สูง (HIGH)</span>${badge}`
                    : `<span class="raw-val is-low"  style="font-size:11px;"><span class="dot"></span>ต่ำ (LOW)</span>${badge}`;
            }

            // แสดงปุ่มคืนค่าอัตโนมัติเฉพาะตอนกำหนดเอง
            const autoBtn = document.getElementById('cfg-auto-' + pin);
            if (autoBtn) autoBtn.style.display = isManual ? 'inline-flex' : 'none';

            // สถานะ
            const triggered = isHigh !== idleIsHigh;
            const statusCell = document.getElementById('raw-status-' + pin);
            if (statusCell) statusCell.innerHTML = triggered
                ? `<span class="raw-status triggering">● มีรถ</span>`
                : `<span class="raw-status not-trigger">○ ว่าง</span>`;

            // เงื่อนไขตรวจจับ
            const hintCell = document.getElementById('raw-hint-' + pin);
            if (hintCell) {
                const triggerOn = idleIsHigh ? 'ต่ำ (LOW)' : 'สูง (HIGH)';
                hintCell.innerHTML = `<span class="raw-hint">สัญญาณเปลี่ยนเป็น ${triggerOn}</span>`;
            }

            // เน้นแถวเมื่อตรวจพบรถ
            const row = document.getElementById('raw-row-' + pin);
            if (row) row.className = triggered ? 'row-active' : '';
        });
    });

    // ── Baseline Config ──
    async function setBaseline(pin, idleIsHigh) {
        const res = await fetch(`/Admin/SetBaseline?pin=${pin}&idleIsHigh=${idleIsHigh}`, { method: 'POST' });
        if (!res.ok) { alert('Failed to set baseline'); return; }
        const time = new Date().toLocaleTimeString();
        const sig  = idleIsHigh ? 'HIGH' : 'LOW';
        const sc   = idleIsHigh ? '#16a34a' : '#dc2626';
        const log  = document.createElement('div');
        log.className = 'log-entry';
        log.innerHTML = `<span class="ts">[${time}]</span> GPIO <span style="color:#2563eb;">${pin}</span> · ตั้งค่าตอนว่าง → <span style="color:${sc};font-weight:700;">${sig}</span> <span class="cfg-manual-badge">กำหนดเอง</span>`;
        document.getElementById('terminal').prepend(log);
    }

    async function clearBaseline(pin) {
        const res = await fetch(`/Admin/ClearBaseline?pin=${pin}`, { method: 'POST' });
        if (!res.ok) { alert('Failed to clear baseline'); return; }
        const time = new Date().toLocaleTimeString();
        const log  = document.createElement('div');
        log.className = 'log-entry';
        log.style.borderLeftColor = '#cbd5e1';
        log.innerHTML = `<span class="ts">[${time}]</span> GPIO <span style="color:#2563eb;">${pin}</span> · คืนค่าอัตโนมัติแล้ว (ระบบตรวจจับเอง)`;
        document.getElementById('terminal').prepend(log);
    }

    async function startDevSignalR() {
        try {
            await devConnection.start();
            statusBadge.textContent = 'เชื่อมต่อแล้ว';
            statusBadge.className   = 'pk-conn-badge live';
        } catch {
            setTimeout(startDevSignalR, 2000);
        }
    }

    startDevSignalR();
</script>
