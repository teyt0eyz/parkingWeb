@model IEnumerable<ParkingWeb.Models.ParkingState>
@{
    ViewData["Title"] = "Developer Console";
    int[] monitorPins = { 17, 27, 22, 23, 24 };
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg:        #f1f5f9;
    --surface:   #ffffff;
    --surface-2: #f8fafc;
    --surface-3: #f1f5f9;
    --border:    #e2e8f0;
    --border-lt: #cbd5e1;
    --ink:       #0f172a;
    --ink-2:     #1e293b;
    --ink-3:     #475569;
    --ink-4:     #94a3b8;
    --green:     #16a34a;
    --green-lt:  rgba(22,163,74,.1);
    --green-bd:  rgba(22,163,74,.3);
    --red:       #dc2626;
    --red-lt:    rgba(220,38,38,.1);
    --red-bd:    rgba(220,38,38,.25);
    --blue:      #2563eb;
    --blue-lt:   rgba(37,99,235,.1);
    --blue-bd:   rgba(37,99,235,.25);
    --amber:     #b45309;
    --amber-lt:  rgba(180,83,9,.08);
    --amber-bd:  rgba(180,83,9,.25);
    --purple:    #7c3aed;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
}

body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
}

/* ── Topbar ── */
.pk-topbar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 28px; height: 58px;
    position: sticky; top: 0; z-index: 100;
    box-shadow: 0 1px 8px rgba(0,0,0,.06);
}
.pk-brand { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: var(--ink); text-decoration: none; }
.pk-logo  { width: 32px; height: 32px; background: linear-gradient(135deg,#2563eb,#6366f1); border-radius: 9px; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(99,102,241,.25); }
.pk-logo svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.pk-nav-tag { font-size: 10px; color: var(--amber); background: var(--amber-lt); border: 1px solid var(--amber-bd); border-radius: 6px; padding: 3px 10px; font-family: 'JetBrains Mono', monospace; font-weight: 600; letter-spacing: .5px; }
.pk-avatar { width: 32px; height: 32px; border-radius: 8px; background: var(--amber-lt); border: 1.5px solid var(--amber-bd); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: var(--amber); }

/* ── Hero ── */
.pk-hero {
    background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
    border-bottom: 1px solid var(--border);
    padding: 28px 32px;
    position: relative; overflow: hidden;
}
.pk-hero::before {
    content: '';
    position: absolute; top: -60px; right: -60px;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(180,83,9,.05) 0%, transparent 70%);
    pointer-events: none;
}
.pk-hero-inner { max-width: 1180px; margin: 0 auto; display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
.pk-crumb { font-size: 11px; color: var(--ink-4); display: flex; align-items: center; gap: 5px; margin-bottom: 6px; font-family: 'JetBrains Mono', monospace; }
.pk-crumb a { color: var(--blue); text-decoration: none; }
.pk-crumb a:hover { text-decoration: underline; }
.pk-crumb svg { width: 8px; height: 8px; stroke: var(--ink-4); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.pk-hero-title { font-size: 22px; font-weight: 700; color: var(--ink); letter-spacing: -.3px; }
.pk-hero-sub   { font-size: 13px; color: var(--ink-3); margin-top: 3px; }
.pk-dev-badge  { display: flex; align-items: center; gap: 8px; background: var(--amber-lt); border: 1px solid var(--amber-bd); border-radius: 100px; padding: 7px 16px; font-size: 12px; color: var(--amber); font-weight: 600; }
.pk-dev-dot    { width: 7px; height: 7px; border-radius: 50%; background: var(--amber); animation: pulse-amber 2s ease-out infinite; }
@@keyframes pulse-amber { 0%{box-shadow:0 0 0 0 rgba(180,83,9,.5);} 70%{box-shadow:0 0 0 7px transparent;} 100%{box-shadow:0 0 0 0 transparent;} }

/* ── Content ── */
.pk-content { max-width: 1180px; margin: 0 auto; padding: 24px 32px 56px; display: flex; flex-direction: column; gap: 20px; }

/* ── Card ── */
.pk-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
.pk-card-head { padding: 14px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--surface-2); }
.pk-card-head-left { display: flex; align-items: center; gap: 10px; }
.pk-card-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.pk-card-icon svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.pk-card-icon.green  { background: linear-gradient(135deg,#15803d,#16a34a); box-shadow: 0 2px 8px rgba(22,163,74,.2); }
.pk-card-icon.blue   { background: linear-gradient(135deg,#1d4ed8,#2563eb); box-shadow: 0 2px 8px rgba(37,99,235,.2); }
.pk-card-icon.amber  { background: linear-gradient(135deg,#92400e,#b45309); box-shadow: 0 2px 8px rgba(180,83,9,.2); }
.pk-card-icon.purple { background: linear-gradient(135deg,#6d28d9,#7c3aed); box-shadow: 0 2px 8px rgba(124,58,237,.2); }
.pk-card-title { font-size: 13px; font-weight: 700; color: var(--ink); }
.pk-card-meta  { font-size: 11px; color: var(--ink-4); font-family: 'JetBrains Mono', monospace; }
.pk-card-body  { padding: 20px; }

/* ── Connection Badge ── */
.pk-conn-badge { font-size: 11px; font-weight: 700; font-family: 'JetBrains Mono', monospace; border-radius: 6px; padding: 4px 10px; }
.pk-conn-badge.live { background: var(--green-lt); color: var(--green); border: 1px solid var(--green-bd); }
.pk-conn-badge.off  { background: var(--red-lt);   color: var(--red);   border: 1px solid var(--red-bd); }

/* ── Mode Toggle (Simulator / Normal) ── */
.mode-toggle {
    display: flex; align-items: center; gap: 4px;
    background: var(--surface-3); border: 1px solid var(--border);
    border-radius: 100px; padding: 3px;
}
.mode-btn {
    border: none; background: transparent; cursor: pointer;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700;
    letter-spacing: .3px; border-radius: 100px; padding: 6px 14px;
    color: var(--ink-4); transition: all .15s; display: flex; align-items: center; gap: 6px;
}
.mode-btn .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .4; flex-shrink: 0; }
.mode-btn:hover { color: var(--ink-2); }
.mode-btn.active.simulator { background: var(--purple); color: #fff; box-shadow: 0 2px 8px rgba(124,58,237,.3); }
.mode-btn.active.simulator .dot { opacity: 1; animation: pulse-amber 2s ease-out infinite; }
.mode-btn.active.normal { background: var(--green); color: #fff; box-shadow: 0 2px 8px rgba(22,163,74,.3); }
.mode-btn.active.normal .dot { opacity: 1; }
.sim-banner {
    display: none; align-items: center; gap: 8px;
    background: rgba(124,58,237,.08);
    border: 1px solid rgba(124,58,237,.25); color: var(--purple);
    border-radius: var(--radius-sm); padding: 8px 14px; margin-bottom: 14px;
    font-size: 12px; font-weight: 600;
}
.sim-banner svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
.sim-banner.show { display: flex; }
.pin-grid.is-locked .dev-btn { opacity: .4; cursor: not-allowed; pointer-events: none; }

/* ── Pin Grid ── */
.pin-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.pin-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px;
    transition: border-color .2s, box-shadow .2s, transform .2s, background .2s;
    position: relative;
    display: flex; flex-direction: column;
}
.pin-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--border); border-radius: var(--radius-md) var(--radius-md) 0 0;
    transition: background .2s;
}
.pin-card:hover { border-color: var(--green-bd); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.08); }
.pin-card:hover::before { background: linear-gradient(90deg, var(--green), #15803d); }
.pin-card.is-active { border-color: var(--green-bd); background: linear-gradient(135deg, var(--surface-2), rgba(22,163,74,.05)); }
.pin-card.is-active::before { background: linear-gradient(90deg, var(--green), #86efac); }

.pin-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 10px; gap: 6px; flex-wrap: wrap;
}
.pin-name { font-size: 12px; font-weight: 700; color: var(--ink-2); line-height: 1.4; min-width: 0; flex: 1; }
.pin-number {
    font-size: 10px; font-family: 'JetBrains Mono', monospace; font-weight: 600;
    color: var(--blue); background: var(--blue-lt); border: 1px solid var(--blue-bd);
    border-radius: 5px; padding: 2px 7px; white-space: nowrap; flex-shrink: 0;
}
.pin-state-row { display: flex; align-items: center; gap: 6px; margin-bottom: 12px; flex-grow: 1; }
.pin-state-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border-lt); transition: all .3s; flex-shrink: 0; }
.pin-state-dot.is-high { background: var(--green); box-shadow: 0 0 6px rgba(22,163,74,.5); }
.pin-state-dot.is-low  { background: var(--red);   box-shadow: 0 0 6px rgba(220,38,38,.4); }
.pin-state-label { font-size: 11px; color: var(--ink-4); font-family: 'JetBrains Mono', monospace; transition: color .3s; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.dev-btn {
    border: none; padding: 9px 4px; border-radius: var(--radius-sm); cursor: pointer;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700;
    transition: all .15s; display: flex; align-items: center; justify-content: center; gap: 4px;
    letter-spacing: .3px; min-width: 0; overflow: hidden; white-space: nowrap;
}
.dev-btn svg { width: 10px; height: 10px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
.btn-high { background: var(--green-lt); color: var(--green); border: 1.5px solid var(--green-bd); }
.btn-high:hover { background: rgba(22,163,74,.18); box-shadow: 0 2px 8px rgba(22,163,74,.15); }
.btn-low  { background: var(--red-lt);   color: var(--red);   border: 1.5px solid var(--red-bd); }
.btn-low:hover  { background: rgba(220,38,38,.18);  box-shadow: 0 2px 8px rgba(220,38,38,.15); }
.dev-btn:active { transform: scale(.96); }

/* ── Two-col equal height ── */
.pk-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: stretch; }
.pk-two-col > .pk-card { display: flex; flex-direction: column; }
.pk-two-col > .pk-card > .pk-card-body { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.pk-two-col .dev-terminal { flex: 1; min-height: 180px; height: auto; }

/* ── GPIO Live Monitor ── */
.monitor-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
.monitor-item {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 14px 10px; background: var(--surface-2); border: 1px solid var(--border);
    border-radius: var(--radius-md); transition: all .3s ease;
    position: relative; cursor: default;
}
.monitor-led-wrap { position: relative; display: flex; align-items: center; justify-content: center; }
.monitor-led {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--border-lt); border: 2px solid var(--border);
    transition: all .3s ease; position: relative; z-index: 1;
}
.monitor-led-ring {
    position: absolute; width: 28px; height: 28px; border-radius: 50%;
    background: transparent; border: 2px solid transparent; transition: all .3s;
}
.monitor-pin  { font-size: 11px; font-weight: 700; color: var(--ink-3); font-family: 'JetBrains Mono', monospace; }
.monitor-name { font-size: 9px; color: var(--ink-4); text-align: center; max-width: 70px; line-height: 1.3; }
.monitor-item.active { border-color: var(--green-bd); background: linear-gradient(135deg, #f0fdf4, #dcfce7); box-shadow: 0 2px 12px rgba(22,163,74,.12); }
.monitor-item.active .monitor-led { background: var(--green); border-color: #86efac; box-shadow: 0 0 10px rgba(22,163,74,.5); }
.monitor-item.active .monitor-led-ring { border-color: rgba(22,163,74,.3); animation: ring-pulse 1.5s ease-out infinite; }
.monitor-item.active .monitor-pin  { color: var(--green); }
.monitor-item.active .monitor-name { color: #15803d; }
@@keyframes ring-pulse { 0%{transform:scale(.9);opacity:1;} 100%{transform:scale(1.6);opacity:0;} }

.monitor-legend { display: flex; gap: 16px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--ink-3); }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* ── Terminal ── */
.dev-terminal {
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    overflow-y: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; line-height: 1.8;
    scrollbar-width: thin; scrollbar-color: var(--border-lt) transparent;
}
.dev-terminal::-webkit-scrollbar { width: 4px; }
.dev-terminal::-webkit-scrollbar-thumb { background: var(--border-lt); border-radius: 4px; }
.log-entry { padding-left: 10px; border-left: 2px solid var(--green); color: var(--ink-2); word-break: break-all; }
.log-entry + .log-entry { margin-top: 3px; }
.log-entry .ts { color: var(--ink-4); margin-right: 6px; }
.log-entry.boot { border-left-color: var(--border-lt); color: var(--ink-4); }
.log-entry.err  { border-left-color: var(--red); }

/* ── Raw GPIO Table ── */
.raw-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.raw-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 640px; }
.raw-table th {
    text-align: left; font-size: 9px; font-weight: 600; color: var(--ink-4);
    text-transform: uppercase; letter-spacing: .7px;
    padding: 10px 14px 8px; border-bottom: 1px solid var(--border);
    background: var(--surface-2); font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
}
.raw-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; color: var(--ink-2); }
.raw-table tbody tr:last-child td { border-bottom: none; }
.raw-table tbody tr:hover td { background: var(--surface-2); }
.raw-table tbody tr.row-active td { background: #dcfce7 !important; }
.raw-table tbody tr.row-active:hover td { background: #bbf7d0 !important; }
.raw-table tbody tr.row-active td:first-child { border-left: 4px solid var(--green); }

.raw-pin-cell { display: flex; flex-direction: column; gap: 2px; }
.raw-pin-num  { font-size: 13px; font-weight: 700; color: var(--blue); font-family: 'JetBrains Mono', monospace; }
.raw-pin-name { font-size: 10px; color: var(--ink-4); }

.raw-val { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 12px; font-family: 'JetBrains Mono', monospace; }
.raw-val .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.raw-val.is-high { color: var(--green); }
.raw-val.is-high .dot { background: var(--green); box-shadow: 0 0 5px rgba(22,163,74,.5); }
.raw-val.is-low  { color: var(--red); }
.raw-val.is-low  .dot { background: var(--red);   box-shadow: 0 0 5px rgba(220,38,38,.4); }
.raw-val.waiting { color: var(--ink-4); font-size: 11px; }

.raw-status { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; border-radius: 6px; padding: 3px 9px; font-family: 'JetBrains Mono', monospace; }
.raw-status.triggering  { background: var(--green-lt); color: var(--green); border: 1px solid var(--green-bd); }
.raw-status.not-trigger { background: var(--surface-2); color: var(--ink-4); border: 1px solid var(--border); }

.raw-hint { font-size: 10px; color: var(--amber); background: var(--amber-lt); border: 1px solid var(--amber-bd); border-radius: 5px; padding: 2px 8px; display: inline-block; font-family: 'JetBrains Mono', monospace; white-space: nowrap; }

/* ── Baseline Config Buttons ── */
.cfg-btn-wrap { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.cfg-btn {
    font-size: 10px; font-weight: 700; font-family: 'JetBrains Mono', monospace;
    border-radius: 6px; padding: 4px 10px; border: 1px solid; cursor: pointer;
    transition: all .15s; line-height: 1.5; white-space: nowrap;
}
.cfg-btn:active { transform: scale(.95); }
.cfg-btn.set-high { background: var(--green-lt); color: var(--green); border-color: var(--green-bd); }
.cfg-btn.set-high:hover { background: rgba(22,163,74,.18); }
.cfg-btn.set-low  { background: var(--red-lt);   color: var(--red);   border-color: var(--red-bd); }
.cfg-btn.set-low:hover  { background: rgba(220,38,38,.18); }
.cfg-btn.set-auto { background: var(--surface-3); color: var(--ink-3); border-color: var(--border-lt); }
.cfg-btn.set-auto:hover { background: var(--border-lt); color: var(--ink-2); }
.cfg-manual-badge { font-size: 9px; font-weight: 700; font-family: 'JetBrains Mono', monospace; background: var(--amber-lt); color: var(--amber); border: 1px solid var(--amber-bd); border-radius: 4px; padding: 1px 5px; }

/* ── Footer ── */
.pk-footer-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; padding-top: 6px; }
.pk-footer-meta { font-size: 11px; color: var(--ink-4); display: flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; }
.pk-footer-meta svg { width: 12px; height: 12px; stroke: var(--ink-4); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.btn-back { font-size: 13px; font-weight: 600; color: var(--ink-2); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 9px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; transition: all .15s; }
.btn-back:hover { background: var(--surface-2); color: var(--ink); border-color: var(--border-lt); }
.btn-back svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* ── Responsive ── */

/* Tablet landscape */
@@media (max-width: 1024px) {
    .pin-grid     { grid-template-columns: repeat(3, 1fr); }
    .monitor-grid { grid-template-columns: repeat(3, 1fr); }
}

/* Tablet portrait */
@@media (max-width: 900px) {
    .pk-two-col   { grid-template-columns: 1fr; }
    .pk-two-col > .pk-card { display: block; }
    .pk-two-col > .pk-card > .pk-card-body { flex: none; display: block; }
    .pk-two-col .dev-terminal { flex: none; height: 220px; }
    .pin-grid     { grid-template-columns: repeat(3, 1fr); }
    .monitor-grid { grid-template-columns: repeat(5, 1fr); }
}

/* Large phone / small tablet (~640px) */
@@media (max-width: 640px) {
    .pk-topbar     { padding: 0 16px; }
    .pk-hero       { padding: 18px 16px; }
    .pk-content    { padding: 14px 16px 40px; }
    .pk-hero-title { font-size: 18px; }
    .pk-hero-sub   { font-size: 12px; }
    .pk-card-body  { padding: 12px; }
    .pk-nav-tag    { display: none; }
    .pk-dev-badge  { font-size: 11px; padding: 5px 12px; }
    .dev-terminal  { height: 190px; }
    .pin-grid      { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .monitor-grid  { grid-template-columns: repeat(3, 1fr); }
    .monitor-name  { display: none; }
    .pk-card-meta  { display: none; }
    .pk-footer-bar { flex-direction: column; align-items: flex-start; }
}

/* Phone portrait (~480px) */
@@media (max-width: 480px) {
    .pk-content    { padding: 12px 12px 36px; }
    .pk-topbar     { padding: 0 12px; }
    .pk-card-head  { padding: 11px 14px; gap: 8px; flex-wrap: wrap; }
    .pk-card-body  { padding: 10px; }
    .pin-grid      { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .pin-card      { padding: 12px 10px; }
    .pin-name      { font-size: 11px; }
    /* ซ่อน SVG ในปุ่ม บนจอแคบ ให้มีที่แสดงข้อความพอ */
    .dev-btn svg   { display: none; }
    .dev-btn       { font-size: 11px; padding: 9px 6px; gap: 0; }
    .monitor-grid  { grid-template-columns: repeat(5, 1fr); gap: 6px; }
    .monitor-item  { padding: 10px 4px; }
    .monitor-led   { width: 14px; height: 14px; }
    .monitor-led-ring { width: 22px; height: 22px; }
    .monitor-pin   { font-size: 9px; }
    .monitor-name  { display: none; }
    .dev-terminal  { height: 160px; font-size: 11px; }
    .cfg-btn-wrap  { flex-direction: column; align-items: flex-start; }
    .pk-hero-inner { flex-direction: column; align-items: flex-start; }
    .pk-dev-badge  { display: none; }
}

/* Very narrow phones (~360px) */
@@media (max-width: 360px) {
    .pk-hero       { padding: 14px 10px; }
    .pk-content    { padding: 10px 10px 32px; }
    .pk-card-body  { padding: 8px; }
    .pin-grid      { grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .pin-card      { padding: 10px 8px; }
    .pin-name      { font-size: 10px; }
    .pin-state-label { display: none; }
    .dev-btn       { font-size: 11px; padding: 8px 4px; }
    .dev-terminal  { height: 140px; }
}
</style>

<!-- ── Topbar ── -->
<div class="pk-topbar">
    <a class="pk-brand" asp-action="Index">
        <div class="pk-logo">
            <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        </div>
        Parking Management System
    </a>
    <div style="display:flex;align-items:center;gap:10px;">
        <span class="pk-nav-tag">DEV CONSOLE</span>
        <div class="pk-avatar">DEV</div>
    </div>
</div>

<!-- ── Hero ── -->
<div class="pk-hero">
    <div class="pk-hero-inner">
        <div>
            <div class="pk-crumb">
                <a href="/Admin">Admin</a>
                <svg viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3"/></svg>
                Developer Console
            </div>
            <div class="pk-hero-title">Developer Console</div>
            <div class="pk-hero-sub">GPIO Simulation · Live Monitor · Raw Readings · Baseline Config</div>
