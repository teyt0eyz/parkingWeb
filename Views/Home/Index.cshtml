@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parking NetVision Kiosk</title>
    <style>
        /* จัดหน้าจอให้เต็ม และพื้นหลังดำสนิท */
        body, html { 
            margin: 0; 
            padding: 0; 
            width: 100%; 
            height: 100%; 
            background-color: black; 
            overflow: hidden; 
        }

        #display-container { 
            position: relative; 
            width: 100vw; 
            height: 100vh; 
        }
        
        #guideImage { 
            position: absolute; 
            top: 0; 
            left: 0;
            width: 100%; 
            height: 100%; 
            object-fit: contain; 
            display: none; /* รูปรถยังคงซ่อนไว้ก่อน */
            transform: translateZ(0); 
            will-change: transform, opacity;
        }

        #idleVideo { 
            position: absolute; 
            top: 0; 
            left: 0;
            width: 100%; 
            height: 100%; 
            object-fit: contain; 
            display: block; /* โชว์ทันทีที่โหลดหน้าเว็บ */
            transform: translateZ(0); 
            will-change: transform, opacity;
        }
        body.rotate-90 #display-container {
        transform: rotate(90deg);
        transform-origin: center;
        width: 100vh;
        height: 100vw;
        margin-left: calc((100vw - 100vh) / 2);
        margin-top: calc((100vh - 100vw) / 2);
        }

        /* หมุน 180 องศา (กลับหัว) */
        body.rotate-180 #display-container { 
            transform: rotate(180deg); 
        }

        /* หมุน 270 องศา (แนวตั้งอีกด้าน) */
        body.rotate-270 #display-container {
            transform: rotate(270deg);
            transform-origin: center;
            width: 100vh;
            height: 100vw;
            margin-left: calc((100vw - 100vh) / 2);
            margin-top: calc((100vh - 100vw) / 2);
        }
    </style>
</head>
<body>

<div id="display-container">
    <video id="idleVideo" src="/videos/idle.mp4" autoplay loop muted playsinline></video>
    
    <img id="guideImage" src="" alt="Car Guide" />
</div>

<script src="~/js/signalr.min.js"></script>

<script>
    const idleVid = document.getElementById('idleVideo');
    const carImg = document.getElementById('guideImage');

    // Unmute เมื่อผู้ใช้แตะ/คลิกหน้าจอครั้งแรก (Kiosk touch to enable sound)
    document.addEventListener('click', function unmuteOnce() {
        idleVid.muted = false;
        document.removeEventListener('click', unmuteOnce);
    }, { once: true });

    // โหลดการหมุนหน้าจอที่เคยเซฟไว้
    (function initRotation() {
        const saved = localStorage.getItem('screenRotation') || '0';
        if (saved !== '0') document.body.classList.add('rotate-' + saved);
    })();

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/parkingHub", { transport: signalR.HttpTransportType.WebSockets })
        .withAutomaticReconnect()
        .build();

    // ✅ รับ 3 พารามิเตอร์ให้ตรงกับ Controller: imagePath, hasCar, activePin
    connection.on("ReceiveStatus", (imagePath, hasCar, activePin) => {
        console.log("🔔 SignalR Received:", { imagePath, hasCar, activePin });

        if (hasCar === true && imagePath && imagePath !== "") {
            const targetUrl = '/uploads/' + imagePath;
            console.log("📸 Changing image to:", targetUrl);
            
            carImg.src = targetUrl;
            carImg.style.display = 'block';
            idleVid.style.display = 'none';
            idleVid.pause(); // หยุดวิดีโอประหยัดพลังงาน
        } else {
            console.log("🎥 Returning to Idle Video");
            carImg.style.display = 'none';
            idleVid.style.display = 'block';
            idleVid.play().catch(e => console.warn("Video Play Error:", e));
        }
    });

    // รับคำสั่ง Mute/Unmute จาก Admin
    connection.on("SetMute", (muted) => {
        idleVid.muted = muted;
    });

    // ระบบหมุนหน้าจอแบบ Real-time
    connection.on("RotateScreen", (degree) => {
        console.log("🔄 Rotating Screen to:", degree);
        document.body.classList.remove('rotate-0', 'rotate-90', 'rotate-180', 'rotate-270');
        if (degree !== 0) document.body.classList.add('rotate-' + degree);
        localStorage.setItem('screenRotation', degree);
    });

    async function startConnection() {
        try {
            await connection.start();
            console.log("✅ Connected to SignalR Hub!");
        } catch (err) {
            console.error("❌ Connection failed, retrying...", err);
            setTimeout(startConnection, 1000); 
        }
    }

    startConnection();
    document.addEventListener('contextmenu', e => e.preventDefault());
</script>
</body>
</html>