@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parking NetVision Kiosk</title>
    <style>
        /* จัดหน้าจอให้เต็ม และพื้นหลังดำสนิท */
        body, html { 
            margin: 0; 
            padding: 0; 
            width: 100%; 
            height: 100%; 
            background-color: black; 
            overflow: hidden; 
        }

        #display-container { 
            position: relative; 
            width: 100vw; 
            height: 100vh; 
        }
        
        #guideImage { 
            position: absolute; 
            top: 0; 
            left: 0;
            width: 100%; 
            height: 100%; 
            object-fit: contain; 
            display: none; /* รูปรถยังคงซ่อนไว้ก่อน */
            transform: translateZ(0); 
            will-change: transform, opacity;
        }

        #idleVideo { 
            position: absolute; 
            top: 0; 
            left: 0;
            width: 100%; 
            height: 100%; 
            object-fit: contain; 
            display: block; /* โชว์ทันทีที่โหลดหน้าเว็บ */
            transform: translateZ(0); 
            will-change: transform, opacity;
        }
    </style>
</head>
<body>

<div id="display-container">
    <video id="idleVideo" src="/videos/idle.mp4" autoplay loop muted playsinline></video>
    
    <img id="guideImage" src="" alt="Car Guide" />
</div>

<script src="~/js/signalr.min.js"></script>

<script>
    const idleVid = document.getElementById('idleVideo');
    const carImg = document.getElementById('guideImage');

    // 1. ตั้งค่า SignalR ให้บังคับใช้ "WebSockets" เท่านั้น (เพื่อความเร็วสูงสุด)
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/parkingHub", {
            transport: signalR.HttpTransportType.WebSockets 
        })
        .withAutomaticReconnect([0, 500, 1000, 2000]) 
        .build();

    connection.on("ReceiveStatus", (imagePath, hasCar) => {
        if (hasCar && imagePath !== "") {
            const targetUrl = '/uploads/' + imagePath;
            
            if (carImg.src.includes(imagePath)) {
                // ถ้ารูปเดิมอยู่แล้ว ไม่ต้องทำอะไร
                carImg.style.display = 'block';
                idleVid.style.display = 'none';
            } else {
                carImg.src = targetUrl;
                carImg.style.display = 'block';
                idleVid.style.display = 'none';
            }
        } else {
            // ซ่อนรูปรถ และกลับมาโชว์วิดีโอ Idle
            carImg.style.display = 'none';
            idleVid.style.display = 'block';
            
            // 🚀 สั่งเล่นวิดีโอซ้ำอีกรอบเผื่อเบราว์เซอร์หยุดมันตอนโดนซ่อน
            idleVid.play().catch(e => console.log("Auto-play prevented: ", e));
        }
    });

    async function startConnection() {
        try {
            await connection.start();
            console.log("✅ Connected!");
        } catch (err) {
            // 3. ลดเวลา Retry เพื่อให้มันเกาะเซิร์ฟเวอร์ได้ไวที่สุดหลังจาก Pi บูตเสร็จ
            setTimeout(startConnection, 500); 
        }
    }

    startConnection();
    // ป้องกันการกดคลิกขวา (โหมด Kiosk)
    document.addEventListener('contextmenu', event => event.preventDefault());
</script>
</body>
</html>